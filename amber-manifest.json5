{
  manifest_version: "0.1.0",

  config_schema: {
    type: "object",
    properties: {
      agent_llm: { type: "string", default: "gpt-4o-mini" },
      llm_model: { type: "string", default: "" },
      openai_api_key: { type: "string", secret: true, default: "" },
      gemini_api_key: { type: "string", secret: true, default: "" },
      anthropic_api_key: { type: "string", secret: true, default: "" },
      deepseek_api_key: { type: "string", secret: true, default: "" },
      openrouter_api_key: { type: "string", secret: true, default: "" },
      openai_base_url: { type: "string", default: "" },
      llm_base_url: { type: "string", default: "" },
      openai_web_search_model: { type: "string", default: "" },
    },
    required: [],
    additionalProperties: false,
  },

  // External services this agent uses.
  slots: {
    proxy: { kind: "a2a", optional: true },
  },

  // Runtime configuration.
  program: {
    image: "ghcr.io/skyc5423/dalpha-agentbeats-purple:latest",
    entrypoint: "uv run src/server.py --host 0.0.0.0 --port 9010",
    env: {
      LLM_MODEL: "${config.llm_model}",
      OPENAI_MODEL: "${config.agent_llm}",
      OPENAI_API_KEY: "${config.openai_api_key}",
      GEMINI_API_KEY: "${config.gemini_api_key}",
      ANTHROPIC_API_KEY: "${config.anthropic_api_key}",
      DEEPSEEK_API_KEY: "${config.deepseek_api_key}",
      OPENROUTER_API_KEY: "${config.openrouter_api_key}",
      OPENAI_BASE_URL: "${config.openai_base_url}",
      LLM_BASE_URL: "${config.llm_base_url}",
      OPENAI_WEB_SEARCH_MODEL: "${config.openai_web_search_model}",
    },

    network: {
      endpoints: [
        { name: "a2a_endpoint", port: 9010 },
      ],
    },
  },

  // Capabilities provided by this agent.
  provides: {
    a2a: { kind: "a2a", endpoint: "a2a_endpoint" },
  },

  // Capabilities exposed to the scenario.
  exports: { a2a: "a2a" },
}
